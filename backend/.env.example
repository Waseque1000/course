# =========================================================================
# BACKEND ENVIRONMENT TEMPLATE (Bloggent LMS)
# =========================================================================

NODE_ENV=development
PORT=5001

# MongoDB Database URL
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.vvmbcal.mongodb.net/bloggent?retryWrites=true&w=majority"

# Auth Credentials
BETTER_AUTH_SECRET=your_auth_secret_key_here
BETTER_AUTH_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000

# SSLCommerz Payment Gateway (Sandbox / Live)
SSLCommerz_STORE_ID=your_store_id
SSLCommerz_STORE_PASSWORD=your_store_password
SSLCommerz_IS_LIVE=false

# Video Streaming Providers
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret
BUNNY_STREAM_LIBRARY_ID=your_bunny_lib_id
BUNNY_STREAM_API_KEY=your_bunny_api_key

# Redis & Background Tasks
REDIS_URL=redis://localhost:6379

# SMTP Email Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_user
SMTP_PASSWORD=your_password
SMTP_FROM=no-reply@bloggent.com
